# For LOCAL use run npm run setup instead. This file is documentation, not usable credentials.
# Server: a long random secret. Only the workspace owner uses this in the browser.
GLAMP_OWNER_TOKEN=
# Server: comma-separated SHA-256 hex hashes. Generate one pair per agent with node scripts/agent-key.mjs.
GLAMP_AGENT_TOKEN_HASHES=
# Agent machine ONLY (the local setup doubles as an agent client).
GLAMP_TOKEN=
GLAMP_URL=http://127.0.0.1:3000

# Needed for hosted cards. Leave empty in local-only development.
DATABASE_URL=
# Needed for hosted images: private Neon Object Storage bucket on the same branch.
NEON_STORAGE_BUCKET=
GLAMP_S3_ENDPOINT=
GLAMP_S3_REGION=
GLAMP_S3_ACCESS_KEY_ID=
GLAMP_S3_SECRET_ACCESS_KEY=

# Optional Web Push. Never expose the private key to the browser or agent.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Local-only alternative to Neon:
# GLAMP_DATA_DIR=.glamp
