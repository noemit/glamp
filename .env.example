# For LOCAL use run npm run setup instead. This file is documentation, not usable credentials.
# Server: a random secret of at least 15 characters. Only the workspace owner uses this in the browser.
# Per-bot tokens are created and revoked directly in the Glamp UI ("Agents" button) — no agent env password needed.
GLAMP_OWNER_TOKEN=
# Agent machine ONLY (optional local CLI).
GLAMP_TOKEN=
GLAMP_URL=http://127.0.0.1:3000

# Added automatically when you connect Neon via Vercel's Storage tab (do not duplicate).
# Optional override: DATABASE_URL. Leave unset for local-only SQLite development.
# Card images are stored directly as binary blobs (bytea) in Neon Postgres by default.
POSTGRES_URL=

# Optional: only set all five if offloading images to an external S3-compatible bucket instead of Neon Postgres blobs.
NEON_STORAGE_BUCKET=
GLAMP_S3_ENDPOINT=
GLAMP_S3_REGION=
GLAMP_S3_ACCESS_KEY_ID=
GLAMP_S3_SECRET_ACCESS_KEY=

# Optional Web Push. Never expose the private key to the browser or agent.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Local-only alternative to Neon:
# GLAMP_DATA_DIR=.glamp
